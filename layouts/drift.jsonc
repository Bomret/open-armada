// Two Borg spheres on team 2 at the centre and one Klingon bird of prey on team 1, 250 units from them, in the
// spheres' range, for play/drift.play: the bird flies circles around the spheres until they destroy it, so it dies
// at speed and coasts.
// Run it with: godot-mono --path . --write-movie play-out/drift/frame.png --fixed-fps 30 -- --game <install>
// --layout layouts/drift.jsonc --play play/drift.play
{
  "bounds": { "minX": 0, "maxX": 4000, "minZ": 0, "maxZ": 4000 },
  "objects": [
    { "class": "bcruise1", "team": 2, "position": [2000, 0, 1950], "label": "Sphere1" },
    { "class": "bcruise1", "team": 2, "position": [2000, 0, 2050], "label": "Sphere2" },
    { "class": "kdestroy", "team": 1, "position": [2250, 0, 2000], "label": "Bop" },
  ],
}

// Every forced motion in one run, for play/forced-motion.play: a black hole (the install's mblkhole: gravity radius 450,
// event radius 70, 70 below the plane) and three Federation destroyers on team 1. Drifter has its engines destroyed and is
// derelict (crew 0, so its engines cannot repair): it starts at rest 100 from the hole's center in the plane, is pulled
// in, swallowed, and shatters into debris. Mover and Holder have thrust, so the hole does not pull them; Mover is ordered
// onto the spot where Holder stands, and the collision separation moves them apart.
// Run it with: godot-mono --path . --write-movie play-out/forced-motion/frame.png --fixed-fps 10 -- --game <install>
// --layout layouts/forced-motion.jsonc --play play/forced-motion.play
{
  "bounds": { "minX": 0, "maxX": 4000, "minZ": 0, "maxZ": 4000 },
  "objects": [
    { "class": "mblkhole", "team": 0, "position": [2000, 0, 2000], "label": "Hole" },
    {
      "class": "fdestroy",
      "team": 1,
      "position": [2000, 0, 2100],
      "label": "Drifter",
      "crew": 0,
      "destroyedSystems": ["Engines"],
    },
    { "class": "fdestroy", "team": 1, "position": [2300, 0, 2000], "label": "Mover" },
    { "class": "fdestroy", "team": 1, "position": [2300, 0, 1900], "label": "Holder" },
  ],
}

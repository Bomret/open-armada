// Two hostile ships 1000 units apart in an empty area: a Federation destroyer on team 1 facing a
// Klingon destroyer on team 2. Open it with: godot-mono --path . -- --game <install> --layout layouts/two-ships.jsonc
{
  "bounds": { "minX": 0, "maxX": 4000, "minZ": 0, "maxZ": 4000 },
  "objects": [
    { "class": "fdestroy", "team": 1, "position": [1500, 0, 2000] },
    { "class": "kdestroy", "team": 2, "position": [2500, 0, 2000] },
  ],
}

// One Federation destroyer on team 1 in an empty area, for play/move.play: a move order shows as move=<x>,<z> in the
// state dump while the ship drives and as move=none once it has arrived.
// Run it with: godot-mono --path . --write-movie play-out/move/frame.png --fixed-fps 10 -- --game <install>
// --layout layouts/move.jsonc --play play/move.play
{
  "bounds": { "minX": 0, "maxX": 4000, "minZ": 0, "maxZ": 4000 },
  "objects": [{ "class": "fdestroy", "team": 1, "position": [2000, 0, 2000], "label": "Mover" }],
}

<Project Sdk="MSTest.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenArmada.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Godot-free engine code is compiled in directly, so the tests run without Godot. -->
    <Compile Include="../../src/Diagnostics/**/*.cs" />
    <Compile Include="../../src/Formats/**/*.cs" />
    <Compile Include="../../src/Assets/**/*.cs" />
    <Compile Include="../../src/Sandbox/**/*.cs" />
    <!-- The viewer's image fit arithmetic, which is Godot-free. -->
    <Compile Include="../../src/Viewer/ImageFit.cs" />
    <!-- The WAV level tool's computation; the tool is a separate project, outside the game build. -->
    <Compile Include="../../tools/WavLevel/WavLevelMeter.cs" />
  </ItemGroup>
</Project>

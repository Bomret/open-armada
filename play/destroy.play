# One Klingon warship destroys a sensor station on kling1; the shots show the explosion at the station.
# Run it with --map kling1; the README, "Run a play script", has the command.
scroll down 20
hold Right 1.4
hold Down 1.6
wait 0.2
shot before
dump before
select Vorcha6
attack Sensor5
wait 3
shot explosion-1
wait 1
shot explosion-2
wait 2
shot explosion-3
dump after
expect Sensor5 destroyed = true

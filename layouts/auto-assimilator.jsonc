  "bounds": { "minX": 0, "maxX": 4000, "minZ": 0, "maxZ": 4000 },
  "objects": [
    { "class": "bcruise2", "team": 1, "position": [1900, 0, 2000], "label": "Assimilator" },
    { "class": "kdestroy", "team": 2, "position": [2000, 0, 2000], "label": "Victim" },
  ],
}

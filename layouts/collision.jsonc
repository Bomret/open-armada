// Two Federation destroyers on team 1 in an empty area, for play/collision.play, both at 38.5, the middle of the combat
// band where a move order's path ends: the Mover is ordered to a point just short of the Holder, so the two meet before
// the Mover arrives and the collision separation moves them apart.
// Run it with: sh tools/play-run.sh collision --layout layouts/collision.jsonc --fps 10
{
  "bounds": { "minX": 0, "maxX": 4000, "minZ": 0, "maxZ": 4000 },
  "objects": [
    { "class": "fdestroy", "team": 1, "position": [2000, 38.5, 2000], "label": "Mover" },
    { "class": "fdestroy", "team": 1, "position": [2000, 38.5, 1900], "label": "Holder" },
  ],
}

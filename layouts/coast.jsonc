// One Klingon bird of prey on team 1 with its engines destroyed and a starting velocity, for play/coast.play: it
// coasts from the first tick along that velocity and brakes at 2.0 units per second per second.
// Run it with: godot-mono --path . --write-movie play-out/coast/frame.png --fixed-fps 30 -- --game <install>
// --layout layouts/coast.jsonc --play play/coast.play
{
  "bounds": { "minX": 0, "maxX": 4000, "minZ": 0, "maxZ": 4000 },
  "objects": [
    {
      "class": "kdestroy",
      "team": 1,
      "position": [1800, 0, 2000],
      "label": "Drifter",
      "destroyedSystems": ["Engines"],
      "velocity": [20, 0, 10],
    },
  ],
}

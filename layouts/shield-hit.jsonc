  "bounds": { "minX": 0, "maxX": 4000, "minZ": 0, "maxZ": 4000 },
  "objects": [
    { "class": "bcruise1", "team": 2, "position": [1900, 0, 1950], "label": "Bush3" },
    { "class": "bcruise1", "team": 2, "position": [1900, 0, 2050], "label": "Bush4" },
    { "class": "kdestroy", "team": 1, "position": [2100, 0, 1950], "label": "Open1" },
    { "class": "kdestroy", "team": 1, "position": [2100, 0, 2050], "label": "Open2" },
  ],

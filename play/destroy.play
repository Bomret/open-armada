# One Klingon warship destroys a sensor station; the shots show the explosion at the station.
# Run it with --layout layouts/destroy.jsonc; the layout's header comment has the command.
wait 0.2
shot before
dump before
select Vorcha6
attack Sensor5
wait 3
shot explosion-1
wait 0.3
shot explosion-2
wait 0.3
shot explosion-3
dump after
expect Sensor5 destroyed = true

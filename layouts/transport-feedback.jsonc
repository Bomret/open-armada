// A Federation destroyer on team 1 100 units from a crippled Klingon destroyer on team 2 (a tenth of its crew, shields at 0,
// weapons destroyed) with a second Klingon destroyer of the same model on team 2 beside it (weapons destroyed, so it
// does not fire), for play/transport-feedback.play: the transport shows its effect and sounds, and the capture
// recolors the Prize alone while the Bystander keeps its color.
// Run it with: sh tools/play-run.sh transport-feedback --layout layouts/transport-feedback.jsonc --fps 30
{
  "bounds": { "minX": 0, "maxX": 4000, "minZ": 0, "maxZ": 4000 },
  "objects": [
    { "class": "fdestroy", "team": 1, "position": [1950, 0, 2000], "label": "Boarder" },
    {
      "class": "kdestroy",
      "team": 2,
      "position": [2050, 0, 2000],
      "label": "Prize",
      "crew": 0.1,
      "shields": 0,
      "destroyedSystems": ["Weapons"],
    },
    {
      "class": "kdestroy",
      "team": 2,
      "position": [2050, 0, 2120],
      "label": "Bystander",
      "destroyedSystems": ["Weapons"],
    },
  ],
}
